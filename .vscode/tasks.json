{
  "version": "2.0.0",
  "tasks": [
    {
      "type": "npm",
      "script": "dev",
      "isBackground": true,
      "problemMatcher": {
        "owner": "typescript",
        "fileLocation": "relative",
        "pattern": {
          "regexp": "^([^:]+):(\\d+):(\\d+):\\s+(error|warning|info)\\s+(TS\\d+)\\s*:\\s*(.*)$",
          "file": 1,
          "line": 2,
          "column": 3,
          "severity": 4,
          "code": 5,
          "message": 6
        },
        "background": {
          "activeOnStart": true,
          "beginsPattern": ".*VITE.*ready in.*",
          "endsPattern": ".*Local:.*http://.*"
        }
      },
      "presentation": {
        "reveal": "always",
        "panel": "dedicated"
      },
      "label": "npm: dev"
    }
  ]
}
